    win.add(help, 210.0, 442.0, 28.0, 28.0);

    let off = Button("Disabled");
    off.setEnabled(false);
    off.setControlSize("small");
    win.add(off, 245.0, 444.0, 90.0, 24.0);

    let check = Checkbox("Enable feature");
    check.onChange(func(): void { global g_check_changes; g_check_changes = g_check_changes + 1; });
    win.add(check, 20.0, 410.0, 150.0, 22.0);

    let sw = Switch();
