    secret.onChange(func(): void { global g_secure_changes; g_secure_changes = g_secure_changes + 1; });
    win.add(secret, 20.0, 264.0, 155.0, 24.0);

    let search = SearchField();
    search.setPlaceholder("Search");
    search.onSubmit(func(): void { global g_search_submits; g_search_submits = g_search_submits + 1; });
    win.add(search, 185.0, 264.0, 155.0, 24.0);

    let slider = Slider(0.0, 100.0, 25.0);
    slider.onChange(func(): void { global g_slider_changes; g_slider_changes = g_slider_changes + 1; });
    slider.setTickMarks(11, false);
    win.add(slider, 20.0, 222.0, 230.0, 30.0);

    let stepper = Stepper(0.0, 10.0, 2.0, 4.0);
    stepper.onChange(func(): void { global g_stepper_changes; g_stepper_changes = g_stepper_changes + 1; });
    win.add(stepper, 260.0, 224.0, 20.0, 28.0);
    let step_label = Label("4");
    win.add(step_label, 285.0, 228.0, 50.0, 20.0);

    let popup = PopUpButton(["Red", "Green", "Blue"]);
    popup.onChange(func(): void { global g_popup_changes; g_popup_changes = g_popup_changes + 1; });
    win.add(popup, 20.0, 186.0, 155.0, 26.0);

    let combo = ComboBox(["Apple", "Banana", "Cherry"], "Kiwi");
    combo.onChange(func(): void { global g_combo_changes; g_combo_changes = g_combo_changes + 1; });
    win.add(combo, 185.0, 186.0, 155.0, 26.0);

    let seg = SegmentedControl(["Day", "Week", "Month"]);
    seg.onChange(func(): void { global g_segment_changes; g_segment_changes = g_segment_changes + 1; });
    win.add(seg, 20.0, 150.0, 220.0, 26.0);

    let bar = ProgressBar(10.0);
