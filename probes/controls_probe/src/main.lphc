            show("as Control", enabled_of(ok) + " " + enabled_of(off) + " " + enabled_of(slider));

            # Checkbox
            show("check initial", bstr(check.checked()));
            check.click();
            show("check after click", bstr(check.checked()) + " changes=" + istr(g_check_changes));
            check.setChecked(false);
            show("check setChecked(false)", bstr(check.checked()) + " changes=" + istr(g_check_changes));
            check.setTitle("Feature on");
