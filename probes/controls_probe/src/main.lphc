    let missing = ImageView();
    let has_missing = missing.loadFile("/nonexistent/none.png");
    win.add(missing, 550.0, 200.0, 70.0, 70.0);

    let aligned = Label("right aligned");
    aligned.setAlignment("right");
    win.add(aligned, 370.0, 170.0, 300.0, 20.0);

    let centered = Label("centered");
    centered.setAlignment("center");
    centered.applyFont(fontNamed("Menlo", 13.0));
    win.add(centered, 370.0, 146.0, 300.0, 20.0);

    let shows: list[View] = radios.buttons();

    if (isSelfTest()) {
        after(0.4, func(): void {
            # Label
            show("label text", title.text());
