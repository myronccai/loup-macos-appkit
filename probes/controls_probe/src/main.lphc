            radios.setSelectedIndex(-1);
            show("radio none", istr(radios.selectedIndex()) + " '" + radios.selectedTitle() + "'");
            radios.click(0);
            show("radio click 0", istr(radios.selectedIndex()) + " changes=" + istr(g_radio_changes));
            radios.setEnabled(true);
            let rf = shows[0].frame();
            show("radio button 0 height>0", bstr(rf.h > 0.0));

            # Switch
            show("switch initial", bstr(sw.isOn()));
            sw.toggle();
            show("switch toggle", bstr(sw.isOn()) + " changes=" + istr(g_switch_changes));
            sw.setOn(false);
            show("switch setOn(false)", bstr(sw.isOn()) + " changes=" + istr(g_switch_changes));
            sw.setOn(true);

            # TextField
            show("field text", field.text());
            show("field placeholder", field.placeholder());
            field.setText("");
            field.typeText("abc");
