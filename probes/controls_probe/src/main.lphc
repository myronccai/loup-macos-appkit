    timed.setShowsTime(true);
    timed.setDate(2024, 2, 29);
    win.add(timed, 540.0, 420.0, 150.0, 24.0);

    let symbol = ImageView();
    let has_symbol = symbol.setSymbol("globe.americas.fill", 40.0);
