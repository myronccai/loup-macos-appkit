    field.onChange(func(): void { global g_text_changes; g_text_changes = g_text_changes + 1; });
    field.onSubmit(func(): void { global g_submits; g_submits = g_submits + 1; });
    win.add(field, 20.0, 296.0, 320.0, 24.0);

    let secret = SecureField();
