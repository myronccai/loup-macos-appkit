            show("label color", color_text(title.textColor()));
            show("label font size", f2(title.font().size()));
            show("note font", note.font().name());
            show("aligned", aligned.alignment());
            show("centered", centered.alignment());
            show("note alignment", note.alignment());
            var bad_align = "no error";
            try {
                note.setAlignment("sideways");
            } catch (ValueError as e) {
                bad_align = "ValueError";
            }
            show("bad alignment", bad_align);

            # Fonts
            let sf = systemFont(12.0, false);
            show("systemFont", f2(sf.size()) + " valid=" + bstr(sf.isValid()));
            let mono = monospacedFont(10.0, true);
            show("monospacedFont", f2(mono.size()));
            show("fontNamed Menlo", fontNamed("Menlo", 13.0).name());
            show("fontNamed missing valid", bstr(fontNamed("NoSuchFontXYZ", 12.0).isValid()));
            show("fixed pitch: mono, Menlo, system, digit font, missing", bstr(mono.isFixedPitch()) + " "
                + bstr(fontNamed("Menlo", 13.0).isFixedPitch()) + " " + bstr(sf.isFixedPitch()) + " "
                + bstr(monospacedDigitSystemFont(12.0, WEIGHT_REGULAR).isFixedPitch()) + " "
                + bstr(fontNamed("NoSuchFontXYZ", 12.0).isFixedPitch()));

            # Button
            ok.click();
            ok.click();
            show("button clicks", istr(g_clicks));
            show("button title", ok.title());
            ok.setTitle("Done");
            show("button setTitle", ok.title());
            show("button key is return", bstr(ok.keyEquivalent() == "\r"));
            show("button bezel", istr(ok.bezelStyle()));
            show("star bezel", istr(star.bezelStyle()));
            show("star symbol", bstr(has_star));
            show("bad symbol", bstr(help.setSymbol("no.such.symbol.xyz")));
            show("bezels", istr(BEZEL_AUTOMATIC) + " " + istr(BEZEL_PUSH) + " " + istr(BEZEL_FLEXIBLE_PUSH) + " " + istr(BEZEL_DISCLOSURE) + " "
                + istr(BEZEL_CIRCULAR) + " " + istr(BEZEL_SMALL_SQUARE) + " " + istr(BEZEL_TOOLBAR) + " "
                + istr(BEZEL_ACCESSORY_BAR) + " " + istr(BEZEL_BADGE));
            show("disabled enabled", bstr(off.isEnabled()));
            off.click();
            show("disabled click count", istr(g_clicks));
            off.sendAction();

            let bf = ok.frame();
