            # RadioGroup
            show("radio count", istr(radios.count()) + " buttons=" + istr(shows.len()));
            show("radio initial", istr(radios.selectedIndex()) + " " + radios.selectedTitle());
            radios.click(2);
            show("radio click 2", istr(radios.selectedIndex()) + " " + radios.selectedTitle() + " changes=" + istr(g_radio_changes));
            radios.setSelectedIndex(1);
