            field.submit();
            show("field submit", "submits=" + istr(g_submits));
            field.setText("set ✓");
            show("field setText", field.text() + " changes=" + istr(g_text_changes));
            show("field editable", bstr(field.isEditable()));
            field.setEditable(false);
            show("field setEditable(false)", bstr(field.isEditable()));
            field.setEditable(true);

            # SecureField
            secret.typeText("hunter2");
            show("secure text", secret.text() + " changes=" + istr(g_secure_changes));
            show("secure placeholder", secret.placeholder());
            show("as TextInput", text_of(secret) + " " + text_of(field));

            # SearchField
            search.typeText("loup");
            search.submit();
            show("search", search.text() + " submits=" + istr(g_search_submits));
            show("search placeholder", search.placeholder());
            search.focus();

            # Slider
            show("slider", f2(slider.value()) + " in " + f2(slider.min()) + ".." + f2(slider.max()));
            slider.setValue(60.0);
            slider.sendAction();
            show("slider setValue", f2(slider.value()) + " changes=" + istr(g_slider_changes));
            slider.setValue(500.0);
            show("slider clamp", f2(slider.value()));
            slider.setMax(200.0);
            slider.setMin(-10.0);
            slider.setValue(150.0);
            show("slider new range", f2(slider.value()) + " in " + f2(slider.min()) + ".." + f2(slider.max()));
            slider.setMax(100.0);
            slider.setMin(0.0);
            slider.setValue(60.0);

            # Stepper
            show("stepper", f2(stepper.value()) + " in " + f2(stepper.min()) + ".." + f2(stepper.max()) + " by " + f2(stepper.increment()));
            stepper.stepUp();
            stepper.stepUp();
            stepper.stepUp();
            show("stepper up x3", f2(stepper.value()) + " changes=" + istr(g_stepper_changes));
            stepper.stepDown();
            show("stepper down", f2(stepper.value()));
            stepper.setWraps(true);
            stepper.stepUp();
            stepper.stepUp();
            show("stepper wrap", f2(stepper.value()));
            stepper.setWraps(false);
            stepper.setIncrement(1.0);
            stepper.setMin(1.0);
            stepper.setMax(20.0);
            stepper.setValue(7.0);
            step_label.setText(f2(stepper.value()));
            show("stepper set", f2(stepper.value()) + " in " + f2(stepper.min()) + ".." + f2(stepper.max()) + " by " + f2(stepper.increment()));

            # PopUpButton
            show("popup items", joined(popup.items()) + " count=" + istr(popup.count()));
            show("popup selected", istr(popup.selectedIndex()) + " " + popup.selectedTitle());
            popup.addItem("Purple");
            popup.select(3);
            popup.sendAction();
            show("popup select 3", istr(popup.selectedIndex()) + " " + popup.selectedTitle() + " changes=" + istr(g_popup_changes));
            popup.selectTitle("Green");
            show("popup selectTitle", istr(popup.selectedIndex()) + " " + popup.selectedTitle());
            popup.setItems(["One", "Two"]);
            show("popup setItems", joined(popup.items()) + " sel=" + popup.selectedTitle());
            popup.removeAll();
            show("popup removeAll", istr(popup.count()) + " sel=" + istr(popup.selectedIndex()));
            popup.setItems(["Red", "Green", "Blue"]);
            popup.select(2);

            # ComboBox
            show("combo", combo.text() + " items=" + joined(combo.items()) + " count=" + istr(combo.count()));
            show("combo selected", istr(combo.selectedIndex()));
            combo.select(1);
            show("combo select 1", combo.text() + " " + istr(combo.selectedIndex()));
            combo.addItem("Date");
            combo.setText("Fig");
            show("combo setText", combo.text() + " count=" + istr(combo.count()));
            combo.sendAction();
            show("combo changes", istr(g_combo_changes));
            combo.setText("");
            combo.typeText("Lime");
            show("combo typed", combo.text() + " changes=" + istr(g_combo_changes));
            combo.setPlaceholder("Fruit");
            show("combo placeholder", combo.placeholder() + " as TextInput=" + text_of(combo));
            combo.removeAll();
            show("combo removeAll", istr(combo.count()));
            combo.addItem("Apple");
            combo.addItem("Cherry");
            combo.setText("Cherry");

            # SegmentedControl
            show("segments", joined(seg.labels()) + " count=" + istr(seg.count()));
            show("segment selected", istr(seg.selectedIndex()) + " " + seg.labelAt(seg.selectedIndex()));
            seg.setSelectedIndex(2);
            seg.sendAction();
            show("segment set 2", istr(seg.selectedIndex()) + " changes=" + istr(g_segment_changes));
            seg.setLabel(1, "Fortnight");
            show("segment setLabel", seg.labelAt(1));
            seg.setSelectedIndex(1);

            # ProgressBar / Spinner
            show("bar", f2(bar.value()) + " / " + f2(bar.max()) + " indeterminate=" + bstr(bar.isIndeterminate()));
            bar.setMax(20.0);
            bar.setValue(13.0);
            show("bar set", f2(bar.value()) + " / " + f2(bar.max()));
            show("busy indeterminate", bstr(busy.isIndeterminate()));
            busy.start();
            show("busy animating", bstr(busy.isAnimating()));
            spinner.start();
            show("spinner animating", bstr(spinner.isAnimating()) + " indeterminate=" + bstr(spinner.isIndeterminate()));
            spinner.stop();
            show("spinner stopped", bstr(spinner.isAnimating()));
            spinner.start();

            # LevelIndicator
            show("level", f2(level.value()) + " in " + f2(level.min()) + ".." + f2(level.max()) + " style=" + istr(level.style()));
            level.setValue(9.0);
            show("level set", f2(level.value()));
            show("rating", f2(rating.value()) + " style=" + istr(rating.style()));
            rating.setValue(4.0);
            rating.sendAction();
            show("rating set", f2(rating.value()) + " changes=" + istr(g_level_changes));
            show("level styles", istr(LEVEL_RELEVANCY) + " " + istr(LEVEL_CONTINUOUS) + " " + istr(LEVEL_DISCRETE) + " " + istr(LEVEL_RATING));

            # ColorWell
            show("well color", color_text(well.color()));
            well.setColor(0.2, 0.4, 0.6, 0.8);
            well.sendAction();
            show("well setColor", color_text(well.color()) + " changes=" + istr(g_color_changes));
            well.setColor(0.95, 0.35, 0.2, 1.0);

            # DatePicker
            date.setDate(2025, 7, 4);
            show("date", date.date() + " y=" + istr(date.year()) + " m=" + istr(date.month()) + " d=" + istr(date.day()));
            date.setDateText("1999-12-31");
            date.sendAction();
            show("date setDateText", date.date() + " changes=" + istr(g_date_changes));
            date.setDate(2025, 13, 1);
            show("date rollover", date.date());
            var bad_date = "no error";
            try {
                date.setDateText("July 4");
            } catch (ValueError as e) {
                bad_date = "ValueError";
            }
            show("bad date text", bad_date);
            show("calendar", cal.date());
            show("leap day", timed.date());
            show("date styles", istr(DATE_STEPPER) + " " + istr(DATE_CALENDAR) + " " + istr(DATE_FIELD));
            date.setStyle(DATE_STEPPER);
            date.setShowsTime(false);
            date.setDate(2026, 11, 1);

            # ImageView
            show("symbol", bstr(has_symbol) + " hasImage=" + bstr(symbol.hasImage()));
            show("symbol size>0", bstr(symbol.imageWidth() > 0.0 and symbol.imageHeight() > 0.0));
            show("icon", bstr(has_icon) + " hasImage=" + bstr(icon.hasImage()));
            show("icon size", f2(icon.imageWidth()) + " x " + f2(icon.imageHeight()));
            show("missing", bstr(has_missing) + " hasImage=" + bstr(missing.hasImage()));
            show("missing size", f2(missing.imageWidth()) + " x " + f2(missing.imageHeight()));
            show("bad symbol image", bstr(missing.setSymbol("no.such.symbol.xyz", 20.0)));
            missing.setSymbol("photo", 32.0);
            missing.setScaling("fit");
            var bad_scale = "no error";
            try {
                missing.setScaling("zoom");
            } catch (ValueError as e) {
                bad_scale = "ValueError";
            }
            show("bad scaling", bad_scale);
            missing.setScaling("none");
            missing.setScaling("fill");
            missing.setScaling("fit");

            # Control size names
            var bad_size = "no error";
            try {
                off.setControlSize("huge");
            } catch (ValueError as e) {
                bad_size = "ValueError";
            }
            show("bad control size", bad_size);
            off.setControlSize("mini");
            off.setControlSize("large");
            off.setControlSize("regular");
            off.setControlSize("small");

            note.setWraps(false);
            note.setWraps(true);
            note.setAlignment("left");
            slider.setVertical(false);

            testAdditions();

            let args = runtime.args();
            if (args.len() > 1) {
                win.snapshot(args[1]);
            }
            quit();
        });
    }
    run(win);
}
